<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWpf>false</UseWpf>
    <UseWindowsForms>false</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.3" />
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="180.18.1" />
    <PackageReference Include="YamlDotNet" Version="18.0.0" />
  </ItemGroup>

  <!--
    SSIS runtime assemblies are NOT on NuGet and cannot be committed to the repo.
    Run `powershell -File setup-ssis-refs.ps1` from the repo root once on any machine
    that has SQL Server Integration Services 16.x installed. That script copies the
    four DLLs from the Windows GAC into lib/ssis/ (gitignored) so the build resolves them.
    See CONTRIBUTING.md for full setup instructions.
  -->
  <ItemGroup>
    <Reference Include="Microsoft.SqlServer.ManagedDTS">
      <HintPath>..\..\lib\ssis\Microsoft.SqlServer.ManagedDTS.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.SqlServer.DTSPipelineWrap">
      <HintPath>..\..\lib\ssis\Microsoft.SqlServer.DTSPipelineWrap.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.SqlServer.DTSRuntimeWrap">
      <HintPath>..\..\lib\ssis\Microsoft.SqlServer.DTSRuntimeWrap.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.SqlServer.SqlTDiagM">
      <HintPath>..\..\lib\ssis\Microsoft.SqlServer.SqlTDiagM.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
