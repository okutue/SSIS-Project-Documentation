<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SsisLineage.Desktop</RootNamespace>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Photino.Blazor" Version="4.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SsisLineage.Core\SsisLineage.Core.csproj" />
    <ProjectReference Include="..\SsisLineage.UI\SsisLineage.UI.csproj" />
  </ItemGroup>

  <!-- Photino's file provider reads a physical wwwroot from the output folder;
       force the app's wwwroot to be copied there (the Razor SDK otherwise keeps
       it only in the static-web-assets manifest). -->
  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
